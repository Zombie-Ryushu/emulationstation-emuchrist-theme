<theme>
    <include>./emuchrist.xml</include>
	
	<variables>
		<themeColor>5B4283</themeColor>
	</variables>


	<view name="system">
	
		<image name="carousel_overlay">
			<color>${themeColor}</color>
		</image>
		
		<image name="logo">
			<path>./logo.png</path>
        </image>
		
	</view>

	<view name="gamelist">
	</view>

	<view name="gamelist">

		<image name="logo">
			<path>./art/invisible.png</path>
		</image>
		
		<image name="basic_border">
			<color>${themeColor}</color>
		</image>
		
		<textlist name="gamelist">
			<primaryColor>${themeColor}</primaryColor>
		</textlist>

	</view>

	<view name="gamelist">
	
		<image name="background">
			<path>./main.jpg</path>
		</image>
		
		<textlist name="gamelist">
		<!--== THIS IS WHERE YOU CHANGE FONT COLOR IN GAME LIST ==-->
			<selectorColor>0000ff</selectorColor>
			<selectedColor>ffffff</selectedColor>
			<primaryColor>${themeColor}</primaryColor>
			<secondaryColor>f0f0f0</secondaryColor>
		</textlist>

	</view>
	
</theme>
