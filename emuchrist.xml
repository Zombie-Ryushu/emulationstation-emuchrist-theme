<theme>
    <view name="system">
        <helpsystem name="help">
            <pos>0.012 0.960</pos>
            <textColor>ffffff</textColor>
            <iconColor>ffffff</iconColor>
            <fontPath>./art/font.ttf</fontPath>
            <fontSize>0.033</fontSize>
        </helpsystem>
        
        <carousel name="systemcarousel">
            <pos>0 0.490</pos>
            <size>1 0.2325</size>
            <color>00000000</color>
            <itemSize>0.20 0.10</itemSize>
            <itemScale>1.7</itemScale>
            <staticImage>./${system.theme}/logo.png</staticImage>
        </carousel>
        
        <text name="systemInfo">
            <pos>0 0.7</pos>
            <color>ffffff80</color>
            <fontPath>./art/font.ttf</fontPath>
            <fontSize>0.027</fontSize>
        </text>
  
        <image name="background">
            <pos>0 0</pos>
            <origin>0 0</origin>
            <size>1 1</size>
            <path>./art/system_background.png</path>
        </image>
        
        <image name="carousel_overlay">
            <pos>0.0 0.0</pos>
            <origin>0 0</origin>
            <size>1 1</size>
            <color>2e3cc9</color>
            <path>./art/system_carousel.png</path>
        </image>
    </view>

    <view name="gamelist">
        <image name="background">
            <pos>0 0</pos>
            <origin>0 0</origin>
            <size>1 1</size>
            <path>./art/system_background.png</path>
        </image>
        
        <image name="basic_border">
            <path>./art/basic.png</path>
        </image>    

        <image name="logo">
            <pos>0.5 0.1083333</pos>
            <maxSize>0.4375 0.133333</maxSize>
            <origin>0.5 0.5</origin>
        </image>

        <image name="md_image">
            <pos>0.74687 0.52708</pos>
            <maxSize>0.38125 0.50833</maxSize>
            <zIndex>40</zIndex>
            <origin>0.5 0.5</origin>
            <imageType>screenshot</imageType>
        </image>
    
        <textlist name="gamelist">
            <pos>0.0578125 0.275</pos>
            <size>0.375 0.641</size>
            <fontSize>0.035</fontSize>
            <lineSpacing>1.25</lineSpacing>
            <horizontalMargin>0.01</horizontalMargin>
            <fontPath>./art/font.ttf</fontPath>
            <selectorColor>574181</selectorColor>
            <selectedColor>ffffff</selectedColor>
            <primaryColor>ffffff</primaryColor>
            <secondaryColor>f0f0f0</secondaryColor>
        </textlist>
        
        <text name="txt_allgames">
            <color>ffffff</color>
            <pos>0.6 0.8520833</pos>    
            <size>0.2953125 0.072917</size>
            <fontPath>./art/font.ttf</fontPath>
            <horizontalAlignment>center</horizontalAlignment>
            <fontSize>0.035</fontSize>
            <text>All Games</text>
        </text>
        
        <text name="md_lbl_playcount">
            <color>ffffff</color>
            <pos>1 1</pos>
            <fontSize>0.03</fontSize>
            <fontPath>./art/font.ttf</fontPath>
        </text>

        <text name="md_playcount">
            <color>ffffff</color>
            <pos>1 1</pos>
            <fontSize>0.03</fontSize>
            <fontPath>./art/font.ttf</fontPath>
        </text>
        
        <text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed">
            <color>ffffff</color>
            <pos>1 1</pos>
            <fontPath>./art/font.ttf</fontPath>
            <fontSize>0.03</fontSize>
        </text>
        
        <text name="md_developer, md_publisher, md_genre, md_players, md_description">
            <color>ffffff</color>
            <pos>1 1</pos>
            <fontPath>./art/font.ttf</fontPath>
            <fontSize>0.03</fontSize>
        </text>
        
         <rating name="md_rating">
            <filledPath>./art/invisible.png</filledPath>
            <unfilledPath>./art/invisible.png</unfilledPath>
        </rating>
        
        <helpsystem name="help">
            <pos>1 1</pos>
        </helpsystem>
    </view>
</theme>
